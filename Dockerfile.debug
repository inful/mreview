# syntax=docker/dockerfile:1.7
#
# Debug image for mreview. Same binary layout as the production
# image, but built on gcr.io/distroless/cc:debug-nonroot which
# ships busybox + glibc + libgcc. Useful for `docker exec -it
# <container> /busybox/sh` debugging and CI jobs that want
# ls/cat/env available alongside the binary.
#
# We use `cc:debug-nonroot` rather than `static:debug-nonroot`
# for the same reason as the production Dockerfile: tokensave
# is dynamically linked against glibc + libgcc.
#
# Multi-arch notes: see Dockerfile. The debug base image is also a
# manifest list, so buildx pulls the right arch variant.
#
# Tokensave bundle: identical to the production Dockerfile. See
# Dockerfile for the version pin rationale and the MCP contract
# that the pin enforces. The CLI shape is `tokensave serve --path <path>`;
# tokensave's older `mcp --project-root` shape is no longer used.
#
# ─── Git bundle (debug image only) ─────────────────────────────
# The debug image bundles `git` so the orchestrator's branch
# sanity check (internal/reviewer/orchestrator.go) actually fires
# in CI. The production image (:latest) deliberately stays
# minimal — operators who use it have already opted into
# "no shell, no extra binaries" and the silent debug-log
# degradation is the correct trade-off for that surface.
#
# Why we need git in the debug image at all: the orchestrator
# fetches the MR's source branch from GitLab, then `git -C
# <workdir> rev-parse --abbrev-ref HEAD` to confirm the workdir
# is checked out on that branch. A mismatch makes tokensave
# index the wrong tree, and the agent's tokensave_* calls
# return data from a different revision than the diff. The
# helper (internal/git/branch.go) returns ErrNoGit when git is
# missing; the debug image's bundle turns that path into a real
# loud WARN at runtime instead of a silent debug log. Local dev
# (where git is on PATH) keeps the same loud WARN regardless.
#
# Vendor strategy: install `git` from debian:bookworm-slim's
# apt repo, copy the binary + its 2 non-libc direct deps
# (libpcre2-8, libz) into a self-contained /out tree, then
# `patchelf --set-rpath '$ORIGIN/../lib'` on the binary so the
# dynamic linker finds the vendored libs at /usr/local/lib in
# the final image. We use `ldd` rather than a hard-coded
# per-arch path list so the same Dockerfile works for both
# linux/amd64 and linux/arm64 — the sonames are stable; the
# absolute /lib/<arch>-linux-gnu/ paths differ per arch.
#
# We do NOT execute git in the builder stage other than the
# self-test at the end of the RUN; the actual exec happens in
# the runtime image, where the rpath is what makes the binary
# find its vendored libs.
#
# Why a debian builder (not alpine): alpine's git is
# dynamically linked against musl, and the distroless runtime
# uses glibc. Copying the musl-linked binary into a glibc
# runtime fails exec with "ld-linux-x86-64.so.1: cannot open
# shared object file" or similar. Building a static git from
# source in alpine would also work (and is the pattern
# tokensave uses, but tokensave is a single self-contained
# Rust binary; git's source build pulls in libpcre2, libz,
# libcurl, openssl, perl, etc. — building all of that static
# from source is a 5+min per-arch build for a 2-package
# alternative).
#
# Version pin: `1:2.39.5-0+deb12u3` (git 2.39.5) in
# debian:bookworm-20240926-slim. The image tag is date-pinned
# so the apt indices are reproducible; the package version is
# pinned so the same git binary is installed on every build
# even if the upstream bookworm repo rolls forward. Fail-closed:
# if either the image tag disappears or the package version is
# pulled, `apt-get install` errors out at build time. The
# git-smoke CI job (scripts/git-smoke.sh) verifies the
# upstream repo still serves the pin before a release.

# Stage 1: download + verify + unpack the pinned tokensave release.
#
# We do NOT execute the binary here: tokensave is dynamically
# linked against glibc, and Alpine ships musl. The kernel
# reports 'not found' when the ELF interpreter
# (ld-linux-{x86_64,aarch64}.so.1) is absent. The distroless
# debug runtime image uses glibc, so the binary runs there.
# SHA256 verification + successful extraction is the build-
# stage proof; the CI smoke job exercises the actual exec.
#
# Alpine's busybox ships wget but not curl; we install curl
# explicitly because the GitHub API download needs
# `-fsSL` semantics (fail on HTTP error, follow redirects,
# silent). Busybox wget has no fail-on-error flag.
FROM alpine:3.20 AS tokensave
ARG TARGETARCH
ARG TOKENSAVE_VERSION=7.12.1
ARG TOKENSAVE_SHA_AMD64=184612db16800e384a1bcdc7fadcc53fa73bda70240f9c0416ac4b88c7e924fb
ARG TOKENSAVE_SHA_ARM64=7de5c95b51d508f39a83d9420ad0700502de107a61dbb38dad3d008d4f6f4261

RUN apk add --no-cache curl \
 && set -eux; \
    case "${TARGETARCH}" in \
        amd64) SHA="${TOKENSAVE_SHA_AMD64}"; ASSET="x86_64"  ;; \
        arm64) SHA="${TOKENSAVE_SHA_ARM64}"; ASSET="aarch64" ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    mkdir -p /out; \
    curl -fsSL --retry 3 -o /tmp/tokensave.tar.gz \
        "https://github.com/aovestdipaperino/tokensave/releases/download/v${TOKENSAVE_VERSION}/tokensave-v${TOKENSAVE_VERSION}-${ASSET}-linux.tar.gz"; \
    echo "${SHA}  /tmp/tokensave.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/tokensave.tar.gz -C /out; \
    chmod 0755 /out/tokensave; \
    test -x /out/tokensave

# Stage 1.5: extract the glibc-compatible busybox from the distroless
# base image itself. The alpine-based tokensave stage above has
# busybox too, but it's dynamically linked against musl; copying
# that binary into a glibc-based runtime fails exec with
# "/lib/ld-musl-x86_64.so.1: not found". The busybox that ships
# in cc:debug-nonroot is statically linked and glibc-clean, so we
# use it instead.
#
# Why a dedicated stage: COPY --from=<external-image> isn't
# supported in BuildKit; we have to declare an explicit FROM
# stage. Using the same image twice is fine — Docker pulls once
# and the second FROM reuses the cache.
FROM gcr.io/distroless/cc:debug-nonroot AS busybox-source

# Stage 1.6: install git from a pinned debian package and vendor
# the binary + its 2 non-libc direct deps into /out. See the file
# header for the full design rationale; this stage exists because
# the orchestrator's branch sanity check needs a real `git` to
# fire in CI rather than degrade to a debug log.
#
# `patchelf --set-rpath '$ORIGIN/../lib'` embeds the rpath in the
# binary so the dynamic linker finds the vendored libs at
# /usr/local/lib in the final image (the binary is placed at
# /usr/local/bin/git; $ORIGIN is /usr/local/bin, so
# $ORIGIN/../lib is /usr/local/lib). No LD_LIBRARY_PATH needed.
#
# `ldd` is used to discover git's direct library deps rather
# than a hard-coded per-arch path list, so the same Dockerfile
# works for both linux/amd64 and linux/arm64. We skip
# `libc.so.6` (already in the distroless cc runtime) and the
# linux-vdso / ld-linux dynamic linker entries (the kernel
# provides those).
FROM debian:bookworm-20240926-slim AS git
ARG GIT_DEB_VERSION=1:2.39.5-0+deb12u3
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        git="${GIT_DEB_VERSION}" \
        patchelf \
        ca-certificates; \
    rm -rf /var/lib/apt/lists/*; \
    mkdir -p /out/bin /out/lib; \
    cp /usr/bin/git /out/bin/git; \
    ldd /out/bin/git \
      | awk '/=>/ {print $3}' \
      | grep -E '\.so' \
      | grep -v 'libc\.so' \
      | xargs -r -I {} cp {} /out/lib/; \
    patchelf --set-rpath '$ORIGIN/../lib' /out/bin/git; \
    # Self-test: actually run the vendored binary. If the rpath
    # is wrong or a lib is missing, this fails here rather than
    # at consumer runtime.
    /out/bin/git --version; \
    test -x /out/bin/git

# Stage 2: distroless debug runtime (busybox shell + glibc + libgcc).
FROM gcr.io/distroless/cc:debug-nonroot AS runtime

ARG TARGETPLATFORM
COPY --chown=65532:65532 ${TARGETPLATFORM}/mreview /mreview
COPY --from=tokensave --chown=65532:65532 /out/tokensave /usr/local/bin/tokensave
# Bundled git so the orchestrator's branch sanity check fires
# in CI. See the file header for the design; the rpath on the
# binary (set by the `git` stage) finds these libs without
# needing LD_LIBRARY_PATH.
COPY --from=git --chown=65532:65532 /out/bin/git /usr/local/bin/git
COPY --from=git --chown=65532:65532 /out/lib/ /usr/local/lib/

# /bin/sh is required by GitLab Runner (and other CI runners) to
# invoke script: blocks. distroless cc:debug-nonroot ships busybox
# only at /busybox/ — there's no /bin/sh and /usr/bin is read-only,
# so an in-Dockerfile symlink won't stick. Add a real shell binary
# at /usr/bin/sh; the base image's /bin -> usr/bin symlink makes
# /bin/sh resolve transparently.
#
# Source: busybox from the distroless base image (busybox-source
# stage). Statically linked; glibc-clean. When invoked with
# argv[0]="sh" the busybox binary dispatches to the shell
# builtin.
COPY --from=busybox-source /busybox/busybox /usr/bin/sh

# Also put mreview on PATH so script: blocks can use `mreview
# review ...` (the standard GitLab CI convention) instead of
# needing /mreview explicitly. The ENTRYPOINT still uses the
# absolute /mreview path; PATH only affects how the shell
# resolves bare command names.
COPY --chown=65532:65532 ${TARGETPLATFORM}/mreview /usr/local/bin/mreview

# Same entrypoint as the production image — debug differs only by
# having a shell available for exec.
ENTRYPOINT ["/mreview"]
