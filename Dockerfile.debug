# syntax=docker/dockerfile:1.7
#
# Debug image for mreview. Same binary layout as the production
# image, but built on gcr.io/distroless/cc:debug-nonroot which
# ships busybox + glibc + libgcc. Useful for `docker exec -it
# <container> /busybox/sh` debugging and CI jobs that want
# ls/cat/env available alongside the binary.
#
# We use `cc:debug-nonroot` rather than `static:debug-nonroot`
# for the same reason as the production Dockerfile: tokensave
# is dynamically linked against glibc + libgcc.
#
# Multi-arch notes: see Dockerfile. The debug base image is also a
# manifest list, so buildx pulls the right arch variant.
#
# Tokensave bundle: identical to the production Dockerfile. See
# Dockerfile for the version pin rationale and the MCP contract
# that the pin enforces. The CLI shape is `tokensave serve --path <path>`;
# tokensave's older `mcp --project-root` shape is no longer used.

# Stage 1: download + verify + unpack the pinned tokensave release.
#
# We do NOT execute the binary here: tokensave is dynamically
# linked against glibc, and Alpine ships musl. The kernel
# reports 'not found' when the ELF interpreter
# (ld-linux-{x86_64,aarch64}.so.1) is absent. The distroless
# debug runtime image uses glibc, so the binary runs there.
# SHA256 verification + successful extraction is the build-
# stage proof; the CI smoke job exercises the actual exec.
#
# Alpine's busybox ships wget but not curl; we install curl
# explicitly because the GitHub API download needs
# `-fsSL` semantics (fail on HTTP error, follow redirects,
# silent). Busybox wget has no fail-on-error flag.
FROM alpine:3.20 AS tokensave
ARG TARGETARCH
ARG TOKENSAVE_VERSION=7.12.1
ARG TOKENSAVE_SHA_AMD64=184612db16800e384a1bcdc7fadcc53fa73bda70240f9c0416ac4b88c7e924fb
ARG TOKENSAVE_SHA_ARM64=7de5c95b51d508f39a83d9420ad0700502de107a61dbb38dad3d008d4f6f4261

RUN apk add --no-cache curl \
 && set -eux; \
    case "${TARGETARCH}" in \
        amd64) SHA="${TOKENSAVE_SHA_AMD64}"; ASSET="x86_64"  ;; \
        arm64) SHA="${TOKENSAVE_SHA_ARM64}"; ASSET="aarch64" ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    mkdir -p /out; \
    curl -fsSL --retry 3 -o /tmp/tokensave.tar.gz \
        "https://github.com/aovestdipaperino/tokensave/releases/download/v${TOKENSAVE_VERSION}/tokensave-v${TOKENSAVE_VERSION}-${ASSET}-linux.tar.gz"; \
    echo "${SHA}  /tmp/tokensave.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/tokensave.tar.gz -C /out; \
    chmod 0755 /out/tokensave; \
    test -x /out/tokensave

# Stage 1.5: extract the glibc-compatible busybox from the distroless
# base image itself. The alpine-based tokensave stage above has
# busybox too, but it's dynamically linked against musl; copying
# that binary into a glibc-based runtime fails exec with
# "/lib/ld-musl-x86_64.so.1: not found". The busybox that ships
# in cc:debug-nonroot is statically linked and glibc-clean, so we
# use it instead.
#
# Why a dedicated stage: COPY --from=<external-image> isn't
# supported in BuildKit; we have to declare an explicit FROM
# stage. Using the same image twice is fine — Docker pulls once
# and the second FROM reuses the cache.
FROM gcr.io/distroless/cc:debug-nonroot AS busybox-source

# Stage 2: distroless debug runtime (busybox shell + glibc + libgcc).
FROM gcr.io/distroless/cc:debug-nonroot AS runtime

ARG TARGETPLATFORM
COPY --chown=65532:65532 ${TARGETPLATFORM}/mreview /mreview
COPY --from=tokensave --chown=65532:65532 /out/tokensave /usr/local/bin/tokensave

# /bin/sh is required by GitLab Runner (and other CI runners) to
# invoke script: blocks. distroless cc:debug-nonroot ships busybox
# only at /busybox/ — there's no /bin/sh and /usr/bin is read-only,
# so an in-Dockerfile symlink won't stick. Add a real shell binary
# at /usr/bin/sh; the base image's /bin -> usr/bin symlink makes
# /bin/sh resolve transparently.
#
# Source: busybox from the distroless base image (busybox-source
# stage). Statically linked; glibc-clean. When invoked with
# argv[0]="sh" the busybox binary dispatches to the shell
# builtin.
COPY --from=busybox-source /busybox/busybox /usr/bin/sh

# Also put mreview on PATH so script: blocks can use `mreview
# review ...` (the standard GitLab CI convention) instead of
# needing /mreview explicitly. The ENTRYPOINT still uses the
# absolute /mreview path; PATH only affects how the shell
# resolves bare command names.
COPY --chown=65532:65532 ${TARGETPLATFORM}/mreview /usr/local/bin/mreview

# Same entrypoint as the production image — debug differs only by
# having a shell available for exec.
ENTRYPOINT ["/mreview"]
